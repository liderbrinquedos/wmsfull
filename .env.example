# Copie para .env antes de subir o ambiente local:
#   cp .env.example .env
#
# O docker compose le este arquivo automaticamente. No Coolify as mesmas
# variaveis sao cadastradas na UI (nunca comitar o .env real).

# ── Banco de dados ──────────────────────────────────────────────────
POSTGRES_DB=logfull
POSTGRES_USER=logfull
POSTGRES_PASSWORD=troque-esta-senha

# Precisa apontar para o mesmo usuario/senha de POSTGRES_* acima.
# Fora do compose (ex.: rodando a API direto na maquina), use localhost:5435.
DATABASE_URL=postgresql://logfull:troque-esta-senha@logfull-db:5432/logfull

# ── Autenticacao (JWT) ──────────────────────────────────────────────
# Obrigatoria, minimo 32 caracteres. Gere com: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── CORS ────────────────────────────────────────────────────────────
# Vazio = apenas a mesma origem (o nginx serve o frontend e faz proxy da API).
# Origens extras, separadas por virgula: https://outro-dominio.com
CORS_ORIGINS=

# ── Dados de demonstracao ───────────────────────────────────────────
# true cria usuarios e produtos de exemplo (senhas conhecidas).
# NUNCA usar true em producao.
SEED_DEMO_DATA=false

# ── Primeiro administrador (producao) ───────────────────────────────
# Criado apenas se a tabela de usuarios estiver vazia. Depois do primeiro
# boot, pode remover estas duas variaveis.
ADMIN_EMAIL=
ADMIN_SENHA=

# ── Ingestao (agente wmsfull-sync) ──────────────────────────────────
# Chave enviada pelo agente no header X-Sync-Key. Gere com:
#   openssl rand -hex 32
# Vazia = endpoints /sync desabilitados (503).
SYNC_API_KEY=

# ── Fuso horario ────────────────────────────────────────────────────
TZ=America/Sao_Paulo
