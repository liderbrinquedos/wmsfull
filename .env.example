# ── Conexao com o banco ─────────────────────────────────────────────
DATABASE_URL=postgresql://logfull:logfull123@logfull-db:5432/logfull

# ── Autenticacao (JWT) ──────────────────────────────────────────────
# Gere um valor forte: openssl rand -hex 32
SECRET_KEY=troque-este-valor-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Nota ────────────────────────────────────────────────────────────
# Os valores acima sao os defaults de backend/app/core/config.py.
# NUNCA comitar o .env real - use o Coolify (UI) ou o ambiente do servidor.
