# API publica
WMS_API_URL=https://wms.suaempresa.com.br
SYNC_API_KEY=

# ERP: postgres | csv
ERP_TIPO=postgres
ERP_DATABASE_URL=postgresql://wms_leitura:senha@192.168.0.10:5432/erp
ERP_VIEW_PRODUTOS=wms_produtos
ERP_VIEW_NF=wms_nf_itens

# Modo CSV (teste ou contingencia)
# ERP_CSV_PRODUTOS=./exemplos/produtos.csv
# ERP_CSV_NF=./exemplos/nf_itens.csv

# Agendamento
SYNC_HORARIOS=06:00,12:00,18:00
SYNC_INTERVALO_SEGUNDOS=120
ERP_JANELA_DIAS=3
SYNC_LOTE=500
SYNC_AO_INICIAR=true
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
